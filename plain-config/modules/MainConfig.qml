// Main File that stores basically all of the configurable information for the shell
// Also stores data that should be compositor agnostic
pragma Singleton
import QtQuick
import Quickshell
import Quickshell.Wayland
import qs.modules.components
/* TODO MainConfig: add the option to switch between manually setting the 
filename/path for config and basing the config's location on wallpaper folder*/
Singleton {
    // Config Selector chooses which config file to use based on the theme, Wallpaper using matugen/pywal template or on user input
    property string user: Quickshell.env("USER")
    property string homeDir: Quickshell.env("HOME")
    property string pictureDir: Quickshell.env("XDG_PICTURES_DIR") || `${homeDir}/Pictures`
    property string videoDir: Quickshell.env("XDG_VIDEOS_DIR") || `${homeDir}/Videos`
    property string configDir: Quickshell.env("XDG_CONFIG_HOME") || `${homeDir}/.config`
    property string wallDir: `${pictureDir}/Wallpapers`
    property string wallpaper: `${wallDir}/Monogatari/tori-gates.png`
    property bool useThemeConfig: false // Use colors from a theme file based on the wallpaper folder/themename
    property bool useGenColors: false // Use colors generated by matugen or pywal?
    // ONLY SET THIS PROPERTY IF THE ABOVE 2 ARE FALSE, won't work if either are true
    property string configFilepath: `${configDir}/quickshell/plain-config/modules/components/BaseConfig.json`
    property string theme: (wallpaper.length!=0)? wallpaper.replace(`${MainConfig.wallDir}`,"").split("/")[1] : "None"
    property string configPath: ConfigSelector.configPath // The config filepath, saving it in case i wanna se it in a different file
    property var config: ConfigSelector.config
    // Qt objects containing all the file configuration options
    property QtObject colors
    property QtObject text
    property QtObject opacity
    property QtObject audio
    property QtObject barInfo
    property QtObject battery
    property QtObject shell
    
    // MainConfig of the bars based on specific config file
    ///////////////////////////////
    // Quickshell Widget windows //
    ///////////////////////////////
    barInfo: QtObject {
        property var layer: WlrLayer.Top
    }
    ///////////
    // Shell //
    ///////////
    shell: QtObject{
        property bool vertBarActive: true
        property bool horiBarActive: true
    }
    /////////////
    // Battery //
    /////////////
    battery: QtObject {
        property bool isFunctional: true
        property bool automaticSuspend: false
    }
    ////////////
    // Colors //
    ////////////
    colors: QtObject {
        property color main: config.colors.primary
        property color secondary: config.colors.secondary
        property color text: config.colors.textcolor
        property color panel: config.colors.panel
        property color outline: config.colors.outline
        property color inactiveWorkspace: config.colors.workspace
    }
    //////////
    // Text //
    //////////
    text: QtObject {
        property real fontSize: config.text.fontSize
        property string fontFamily: config.text.fontFamily
        property string secondaryFontFamily: config.text.secondaryFontFamily
    }
    /////////////
    // Opacity //
    /////////////
    opacity: QtObject {
        property real main: config.opacity.main
        property real text: config.opacity.text
        property real button: config.opacity.button
    }
    ///////////
    // Audio //
    ///////////
    audio: QtObject {
        property bool protectionEnabled: false
        property real maxAllowedIncrease: 30
        property real maxAllowed: 100
        property string folder: config.audio.folder
        function playSystemSound(soundName) {
            const ogaPath = `/usr/share/sounds/${audio.folder}/stereo/${soundName}.oga`;
            const oggPath = `/usr/share/sounds/${audio.folder}/stereo/${soundName}.ogg`;
            /* Add this to play mp3 files
            const mp3Path = `/home/dani/Downloads/${soundName}.mp3`;
            // Try playing .mp3 
            let command = [
                "ffplay",
                "-nodisp",
                "-autoexit",
                mp3Path
            ];
            Quickshell.execDetached(command);*/
            // Try playing .oga first
            let command = [
                "ffplay",
                "-nodisp",
                "-autoexit",
                ogaPath
            ];
            Quickshell.execDetached(command);
            // Also try playing .ogg (ffplay will just fail silently if file doesn't exist)
            command = [
                "ffplay",
                "-nodisp",
                "-autoexit",
                oggPath
            ];
            Quickshell.execDetached(command);
        }
    }
}
